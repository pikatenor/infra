{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests"
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "mirror.gcr.io/bitnami/postgresql",
        "c.p1kachu.net/*",
        "registry.p1kachu.net:5000/*"
      ],
      "enabled": false
    },
    {
      "groupName": "cert-manager",
      "matchDatasources": ["docker"],
      "matchPaths": [
        "yuzu/**"
      ],
      "matchPackageNames": [
        "quay.io/jetstack/cert-manager-*"
      ]
    },
    {
      "matchUpdateTypes": [
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "matchManagers": ["regex"],
      "matchPackageNames": ["rancher/rancher"],
      "description": "README version bumps are notification-only;",
      "automerge": false,
      "separateMinorPatch": true,
      "prBodyNotes": [
        ":warning: This only updates the documented version. Before merging, re-render and apply templates manually, or the deployed version will drift."
      ]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the pinned rancher version in the manual upgrade procedure",
      "fileMatch": ["^yuzu/cattle-system/README\\.md$"],
      "matchStrings": ["helm template\\s+\\S+\\s+\\S+/rancher\\b[^\\n]*--version (?<currentValue>\\S+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "rancher/rancher",
      "extractVersionTemplate": "^v?(?<version>.+)$"
    }
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/^borg4/.+\\.ya?ml$/",
      "/^starlight30/.+\\.ya?ml$/",
      "/^yuzu/.+\\.ya?ml$/"
    ],
    "ignorePaths": [
      ".*fleet\\.yaml$",
      "yuzu/cattle-system/"
    ]
  }
}
